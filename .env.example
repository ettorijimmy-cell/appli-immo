# Copier ce fichier en .env et renseigner les vraies valeurs.
# Ne jamais committer .env — voir CLAUDE.md.

# Scaleway (docs/integrations.md). OBJECT_STORAGE_ACCESS_KEY/
# OBJECT_STORAGE_SECRET_KEY/OBJECT_STORAGE_BUCKET_NAME pilotent aussi le
# stockage des documents (Module 4, voir DOCUMENTS_STORAGE_DIR plus bas) :
# présentes → bucket Object Storage ; absentes → disque local.
# Nommage volontairement SANS préfixe SCW_ — ce préfixe est réservé par
# Scaleway pour sa propre configuration produit et rejeté par le formulaire
# Serverless Containers (voir docs/error-log.md, [2026-08-11]), même si les
# valeurs elles-mêmes restent les identifiants Access Key/Secret Key
# Scaleway.
DATABASE_URL=postgres://user:password@host:5432/appli_immo
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET_NAME=

# Backend NestJS — authentification
# Obligatoire si NODE_ENV=production (voir auth.module.ts) — le backend
# refuse de démarrer sinon. Repli sur une valeur par défaut en dev
# uniquement.
JWT_SECRET=
# Défaut interne si absente : 3600 (1h). Production actuelle : 14400 (4h),
# pour couvrir une visite longue avec signatures sans déconnexion en
# cours de route (voir docs/backlog.md, "Hébergement mobile-web") — réglée
# directement comme variable d'environnement du conteneur Scaleway, jamais
# dans un fichier.
JWT_EXPIRES_IN_SECONDS=3600
PORT=3000

# Backend NestJS — chiffrement applicatif (IBAN/BIC, documents Module 4)
# Obligatoire si NODE_ENV=production (voir crypto/encryption.service.ts) —
# le backend refuse de démarrer sinon. Repli sur une clé de développement
# connue en dev uniquement. Clé AES-256 encodée en base64 (32 octets) —
# générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# PowerSync — synchronisation Electron ↔ Postgres (voir
# docs/data-dictionary.md, section Authentification, et docs/integrations.md).
# Jeton distinct du JWT applicatif ci-dessus, signé HS256 avec un secret
# dédié configuré dans le dashboard PowerSync (Client Auth → HS256
# Authentication Tokens). Aucun repli de développement possible — ce
# secret correspond à un compte externe réel, toujours à définir
# explicitement (voir apps/backend/src/powersync/powersync.service.ts).
# POWERSYNC_JWT_KID : le KID choisi lors de l'ajout du secret dans ce même
# écran du dashboard. POWERSYNC_URL : l'URL d'instance PowerSync (sert à
# la fois de claim `aud` du jeton et d'endpoint renvoyé au client).
POWERSYNC_JWT_SECRET=
POWERSYNC_JWT_KID=
POWERSYNC_URL=

# Documents (Module 4) — dossier de stockage local, utilisé UNIQUEMENT si
# OBJECT_STORAGE_ACCESS_KEY/OBJECT_STORAGE_SECRET_KEY/
# OBJECT_STORAGE_BUCKET_NAME sont absentes (voir
# docs/data-dictionary.md, section documents — même bascule que DATABASE_URL
# entre Postgres local et Scaleway). Défaut si absent : storage/documents
# relatif au dossier apps/backend.
DOCUMENTS_STORAGE_DIR=

# Tableau de bord (Module 7) — dossier des sauvegardes locales
# (pnpm backup:local, scripts/backup-local.mjs) pour afficher la date de la
# dernière. Défaut si absent : backups/ à la racine du repo (relatif au
# dossier apps/backend).
BACKUPS_DIR=

# Backend NestJS — intégration Gmail API/OAuth2 (Module Tâches, Étape 3)
# Obligatoires si NODE_ENV=production (voir google-oauth/google-oauth.service.ts)
# — le backend démarre quand même (pas de garde au démarrage comme
# JWT_SECRET/ENCRYPTION_KEY), mais toute route /gmail/* échoue bruyamment
# tant qu'elles ne sont pas renseignées. Client OAuth2 créé côté Google
# Cloud Console, scope gmail.send (sensible, pas restreint), statut de
# publication "En production" (pas de limite de 7 jours sur les jetons).
# Nommage sans préfixe SCW_ — voir DATABASE_URL ci-dessus.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL publique du backend + /gmail/callback (celle enregistrée comme
# "URI de redirection autorisée" côté Google Cloud Console) — jamais
# localhost en production, Google doit pouvoir y rediriger le navigateur
# système de l'utilisateur. Défaut si absent : http://localhost:3000/gmail/callback
# (dev uniquement).
GOOGLE_REDIRECT_URI=

# Desktop (Electron) — origine du backend, aussi utilisée par la CSP
# (electron.vite.config.ts) et l'appel API (lib/api-config.ts). Obligatoire
# en build de production (échec bruyant sinon, voir vite.config.ts) —
# Electron et le backend ne sont jamais sur la même origine. Défaut si
# absent : http://localhost:3000 (dev uniquement).
#
# Mobile web (apps/mobile-web) — MÊME variable, mécanisme différent depuis
# l'hébergement sous /mobile/ (voir docs/backlog.md, "Hébergement
# mobile-web") : optionnelle en production, où elle n'a normalement PAS
# lieu d'être définie — l'appli est servie par le même backend sous
# /mobile/, donc une URL relative (même origine, sans CORS) est le défaut.
# Une URL complète ici reste prise en compte si présente (réversibilité
# vers un hébergement séparé, voir plus bas). En dev, défaut si absent :
# http://localhost:3000, inchangé.
VITE_API_URL=

# Mobile web (apps/mobile-web) — préfixe de montage du build, lu dans
# vite.config.ts DIRECTEMENT sur process.env au moment du build (jamais
# via ce fichier .env ni envDir — la définir ici n'a aucun effet). Le
# Dockerfile du backend ne la définit pas, d'où "/mobile/" par défaut
# (hébergement actuel, sous-chemin du backend) ; à fournir dans
# l'environnement de la commande de build elle-même si besoin un jour
# (ex. hébergement séparé, voir plus bas). Toujours terminer par "/" —
# Vite s'en sert tel quel comme préfixe d'URL des assets générés. "/" sert
# l'appli à la racine (hébergement séparé futur, voir docs/backlog.md,
# "Hébergement mobile-web", chemin de migration).
# MOBILE_WEB_BASE_PATH=

# Backend NestJS — verrou HTTP Basic devant /mobile uniquement (jamais
# l'API, voir docs/backlog.md, "Hébergement mobile-web", et
# src/mobile-web/). Comparaison à temps constant, jamais journalisée.
# Actif par défaut ; MOBILE_WEB_BASIC_AUTH_ENABLED=false le désactive
# entièrement (prévu pour le jour où /mobile sera ouvert à des clients
# authentifiés par leur propre compte, voir chemin de migration dans le
# backlog). Si actif mais USER/PASSWORD manquent : /mobile répond 503,
# sans jamais empêcher le backend de démarrer ni affecter l'API.
MOBILE_WEB_BASIC_AUTH_ENABLED=
MOBILE_WEB_BASIC_AUTH_USER=
MOBILE_WEB_BASIC_AUTH_PASSWORD=

# Conversion PDF de l'état des lieux (chantier PDF étape 4, 2026-10-27) —
# Serverless Container Gotenberg séparé, sur le Réseau Privé du backend,
# jamais exposé publiquement (voir docs/backlog.md). Si GOTENBERG_URL est
# absente, la conversion PDF est simplement indisponible : le backend
# démarre normalement, aucune route ni aucun job n'en dépend pour
# fonctionner (src/gotenberg/gotenberg.service.ts). URL sans "/" final,
# sans le chemin /forms/libreoffice/convert (ajouté par le client).
GOTENBERG_URL=
GOTENBERG_BASIC_AUTH_USERNAME=
GOTENBERG_BASIC_AUTH_PASSWORD=
# Délai avant abandon de l'appel, en millisecondes — généreux par défaut
# (60000) pour couvrir le réveil d'un conteneur Serverless scale-to-zero.
GOTENBERG_TIMEOUT_MS=
