node_modules/
dist/
out/
build/
.turbo/
*.tsbuildinfo

# Icône source du packaging desktop (apps/desktop/build/, convention
# electron-builder) — même pattern que tmp/ ci-dessous : "build/" reste
# ignoré partout (sorties de build), sauf ce fichier précis, qui est un
# asset source versionné, pas un artefact généré.
!apps/desktop/build/
apps/desktop/build/*
!apps/desktop/build/icon.ico

.env
.env.*
!.env.example
# VITE_API_URL production (URL Scaleway du backend) n'est pas un secret —
# committé pour que le build de packaging desktop (electron-builder,
# apps/desktop) l'utilise automatiquement, sans ressaisie manuelle.
!.env.production

*.sqlite
*.sqlite-journal

backups/
# Anchré (pas juste "storage/") : un motif non ancré matche N'IMPORTE QUEL
# dossier nommé "storage" dans tout le repo, y compris du code source
# (apps/backend/src/documents/storage/) — découvert le 2026-08-10, ce
# dossier de code était invisible à git depuis sa création. Seul le
# stockage local de blobs documents (données réelles, jamais versionnées)
# doit être ignoré ici.
/apps/backend/storage/
# tmp/ reste le dossier de travail (sorties de génération jetables, PDFs de
# test, fragments...), mais les deux modèles Word sont la source de vérité
# du contenu légal généré (bail, état des lieux) — sans backup ailleurs
# (pnpm backup:local ne sauvegarde que Postgres). Versionnés malgré leur
# nature binaire pour bénéficier de l'historique/sauvegarde git, plutôt que
# de dépendre d'une copie manuelle sur un seul poste.
tmp/*
!tmp/Modèle bail.docx
!tmp/Modèle état des lieux.docx

.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
